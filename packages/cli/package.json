{
  "name": "@aliou/sesame-cli",
  "version": "0.13.1",
  "private": true,
  "description": "CLI for Sesame BM25 search",
  "type": "module",
  "bin": {
    "sesame": "dist/sesame.cjs"
  },
  "scripts": {
    "build": "tsdown && chmod +x dist/sesame.cjs && node scripts/smoke-build.mjs",
    "typecheck": "tsc --noEmit",
    "build:binary": "SESAME_EXE=1 tsdown",
    "completions": "node scripts/write-completions.mjs",
    "dev": "tsdown --watch",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:cli": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run --config vitest.cli.config.ts"
  },
  "author": "Aliou Diallo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aliou/sesame",
    "directory": "packages/cli"
  },
  "dependencies": {
    "@aliou/sesame": "workspace:*",
    "@bomb.sh/tab": "^0.0.22",
    "@drizzle-team/brocli": "0.12.1"
  },
  "devDependencies": {
    "@tsdown/exe": "0.23.0",
    "@types/node": "^26.2.0",
    "tsdown": "0.23.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
