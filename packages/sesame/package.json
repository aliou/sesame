{
  "name": "@aliou/sesame",
  "version": "0.14.0",
  "description": "BM25 search for coding agent sessions",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./worker": "./dist/storage/search-worker.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown index.ts --no-config --format esm --out-dir dist --clean --no-dts && tsdown storage/search-worker.ts --no-config --format esm --out-dir dist/storage --no-clean --no-dts && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "bm25-search",
    "coding-agent",
    "pi",
    "sqlite"
  ],
  "author": "Aliou Diallo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aliou/sesame",
    "directory": "packages/sesame"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "memfs": "^4.68.1",
    "tsdown": "0.23.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
