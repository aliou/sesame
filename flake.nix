{
  description = "sesame - BM25 search for coding agent sessions";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    flake-utils.url = "github:numtide/flake-utils";
  };

  outputs = { self, nixpkgs, flake-utils }:
    let
      version = "0.14.1";

      binaries = {
        "aarch64-darwin" = {
          url = "https://github.com/aliou/sesame/releases/download/@aliou/sesame-cli@${version}/sesame-darwin-arm64";
          hash = "sha256-9oW3CgGyo5WI0vi4YOt5D9031HMcQ+npG75kyEFuY34="; # darwin
        };
        "aarch64-linux" = {
          url = "https://github.com/aliou/sesame/releases/download/@aliou/sesame-cli@${version}/sesame-linux-arm64";
          hash = "sha256-u/CRCekrEoGsPI/4ymk8zOL0/1Q3iEs52Cw1hToNavk="; # linux-arm64
        };
        "x86_64-linux" = {
          url = "https://github.com/aliou/sesame/releases/download/@aliou/sesame-cli@${version}/sesame-linux-x64";
          hash = "sha256-G5sh6SKWNyAi3Pqk9jXPMxSucY8cXgEKMMRpYyYJk/Q="; # linux-x64
        };
      };

      fetchBinary = pkgs: system:
        let
          binary = binaries.${system} or (throw "Unsupported system: ${system}");
        in
        pkgs.stdenv.mkDerivation {
          pname = "sesame";
          inherit version;

          src = pkgs.fetchurl {
            url = binary.url;
            hash = binary.hash;
          };

          dontUnpack = true;

          nativeBuildInputs = [ pkgs.installShellFiles ];

          # The completion scripts are committed in ./completions rather than
          # generated by running the binary: the Linux SEA is an unpatched ELF
          # that cannot run inside the build sandbox.
          installPhase = ''
            mkdir -p $out/bin
            cp $src $out/bin/sesame
            chmod +x $out/bin/sesame
            installShellCompletion \
              --bash --name sesame ${./completions/sesame.bash} \
              --fish --name sesame.fish ${./completions/sesame.fish} \
              --zsh --name _sesame ${./completions/_sesame}
          '';

          meta = with pkgs.lib; {
            description = "BM25 search for coding agent sessions";
            homepage = "https://github.com/aliou/sesame";
            license = licenses.mit;
            platforms = [ "aarch64-darwin" "aarch64-linux" "x86_64-linux" ];
            mainProgram = "sesame";
          };
        };
    in
    flake-utils.lib.eachSystem [ "aarch64-darwin" "aarch64-linux" "x86_64-linux" ] (system:
      let
        pkgs = nixpkgs.legacyPackages.${system};
        sesame = fetchBinary pkgs system;
      in
      {
        packages = {
          default = sesame;
          sesame = sesame;
          sesame-binary = sesame;
        };

        apps.default = {
          type = "app";
          program = "${sesame}/bin/sesame";
        };

        devShells.default = pkgs.mkShell {
          packages = with pkgs; [
            nodejs_26
            pnpm
            sqlite
          ];
        };
      }
    );
}
